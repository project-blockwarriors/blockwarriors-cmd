# Public site URL used for metadata, sitemap, and robots output.
NEXT_PUBLIC_BASE_URL=http://localhost:3000

# Convex client configuration used by the Next.js dashboard.
NEXT_PUBLIC_CONVEX_DEPLOYMENT=your-convex-deployment
NEXT_PUBLIC_CONVEX_URL=https://your-deployment.convex.cloud
NEXT_PUBLIC_CONVEX_SITE_URL=https://your-deployment.convex.site

# Server-side fallback for HTTP route calls from Next.js server actions.
CONVEX_SITE_URL=https://your-deployment.convex.site
