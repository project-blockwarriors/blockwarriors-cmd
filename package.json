{
  "name": "blockwarriors-cmd",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "BlockWarriors Command Block monorepo",
  "packageManager": "npm@11.6.3",
  "engines": {
    "node": ">=20.9.0"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "turbo dev",
    "dev:web": "npm run dev --workspace blockwarriors-next",
    "dev:backend": "npm run dev --workspace @packages/backend",
    "dev:bot-orchestrator": "npm run dev --workspace bot-orchestrator",
    "build": "turbo build && npm run build:beacon",
    "build:web": "npm run build --workspace blockwarriors-next",
    "build:backend": "npm run build --workspace @packages/backend",
    "build:shared": "npm run build --workspace @packages/shared",
    "build:bot-orchestrator": "npm run build --workspace bot-orchestrator",
    "build:beacon": "npm run codegen:beacon && mvn -f apps/blockwarriors-beacon/pom.xml -B package",
    "format:check": "prettier --check .",
    "format:write": "prettier --write .",
    "lint": "turbo lint",
    "lint:fix": "npm run lint --workspace blockwarriors-next -- --fix && npm run lint --workspace bot-orchestrator -- --fix",
    "typecheck": "turbo typecheck",
    "test": "npm run test:beacon",
    "test:beacon": "mvn -f apps/blockwarriors-beacon/pom.xml -B test",
    "test:http": "npm run test:http --workspace @packages/backend",
    "test:game": "node --import tsx packages/game-tests/src/runner.ts",
    "codegen": "npm run codegen:backend && npm run codegen:beacon",
    "codegen:backend": "npm run codegen --workspace @packages/backend",
    "codegen:beacon": "node scripts/generate-beacon-game-config.mjs",
    "deploy:beacon": "node scripts/deploy-beacon.mjs",
    "deploy:beacon:dry-run": "node scripts/deploy-beacon.mjs --dry-run",
    "deploy": "npm run deploy --workspace @packages/backend",
    "convex:dashboard": "npm run dashboard --workspace @packages/backend",
    "validate": "npm run lint && npm run typecheck && npm run test"
  },
  "devDependencies": {
    "baseline-browser-mapping": "^2.10.7",
    "prettier": "^3.6.2",
    "turbo": "^2.3.3"
  },
  "dependencies": {
    "uuid": "^13.0.0"
  }
}
