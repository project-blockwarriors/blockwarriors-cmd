# This monorepo uses per-package environment files.
# Copy the example file that matches the runtime you are working on:
#
# - apps/blockwarriors-next/.env.example
# - packages/backend/.env.example
# - apps/bot-orchestrator/.env.example
# - apps/blockwarriors-beacon/.env.example
#
# Optional root-level env vars for Beacon deploy automation:
#
# PTERODACTYL_PANEL_URL=https://mcpanel.blockwarriors.ai
# PTERODACTYL_API_KEY=ptlc_your_client_api_key
# PTERODACTYL_SERVER_UUID=your_server_uuid
# PTERODACTYL_SERVER_NAME=Fast Dev - YourName
# PTERODACTYL_PLUGIN_DIRECTORY=/plugins
# PTERODACTYL_PLUGIN_FILENAME=beacon.jar
# PTERODACTYL_RESTART_SIGNAL=restart
# PTERODACTYL_BACKUP_EXISTING_PLUGIN=true
# BEACON_JAR_PATH=apps/blockwarriors-beacon/target/beacon-0.0.1.jar
# BEACON_DEPLOY_ARTIFACT_URL=
